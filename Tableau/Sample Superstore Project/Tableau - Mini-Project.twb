    <worksheet name='Segments - bar chart'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders+ (sample_-_superstore)' name='federated.1dvdmde06x56491ec5whj0g1w0bu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Year Selected' datatype='integer' default-format='n0;-0' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2015'>
              <calculation class='tableau' formula='2015' />
            </column>
            <column alias='PROFIT' caption='Metric Swap Parameter' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Profit&quot;'>
              <calculation class='tableau' formula='&quot;Profit&quot;' />
              <aliases>
                <alias key='&quot;Orders&quot;' value='ORDERS' />
                <alias key='&quot;Profit&quot;' value='PROFIT' />
                <alias key='&quot;Sales&quot;' value='SALES' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dvdmde06x56491ec5whj0g1w0bu'>
            <column caption='Sales Selected Year' datatype='real' default-format='C1033%' name='[Calculation_1457758924819922944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1]&#13;&#10;THEN [Sales]&#13;&#10;END' />
            </column>
            <column caption='Selected Year' datatype='integer' default-format='n0;-0' name='[Calculation_1457758924844011525]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='Profit Selected Year' datatype='real' name='[Calculation_1457758924845793287]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1]&#13;&#10;THEN [Profit]&#13;&#10;END' />
            </column>
            <column caption='Profit Previous Year' datatype='real' name='[Calculation_1457758924846129160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1] - 1&#13;&#10;THEN [Profit]&#13;&#10;END' />
            </column>
            <column caption='Metric Swap Calcs SY' datatype='real' name='[Calculation_345651293204406272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Sales&quot; THEN ZN(SUM([Calculation_1457758924819922944]))&#13;&#10;WHEN &quot;Profit&quot; THEN ZN(SUM([Calculation_1457758924845793287]))&#13;&#10;WHEN &quot;Orders&quot; THEN ZN(COUNTD([Calculation_984318014302420992]))&#13;&#10;END' />
            </column>
            <column caption='Metric Swap Calcs SY (label)' datatype='string' name='[Calculation_345651293207142403]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Sales&quot; THEN &quot;$&quot; + STR(ROUND(SUM([Calculation_1457758924819922944])/1000, 1)) + &quot;K&quot;&#13;&#10;WHEN &quot;Profit&quot; THEN &quot;$&quot; + STR(ROUND(SUM([Calculation_1457758924845793287])/1000, 1)) + &quot;K&quot;&#13;&#10;WHEN &quot;Orders&quot; THEN STR(COUNTD([Calculation_984318014302420992]))&#13;&#10;END' />
            </column>
            <column caption='Metric Swap Calcs YoY' datatype='real' default-format='p0.00%' name='[Calculation_345651293208256518]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Sales&quot; THEN (SUM([Calculation_1457758924819922944]) - SUM([Sales Selected Year (copy)_1457758924820250625])) / SUM([Sales Selected Year (copy)_1457758924820250625])&#13;&#10;WHEN &quot;Profit&quot; THEN (SUM([Calculation_1457758924845793287]) - SUM([Calculation_1457758924846129160])) / SUM([Calculation_1457758924846129160])&#13;&#10;WHEN &quot;Orders&quot; THEN (COUNTD([Calculation_984318014302420992]) - COUNTD([Orders Selected Year (copy)_984318014302593025])) / COUNTD([Orders Selected Year (copy)_984318014302593025])&#13;&#10;END' />
            </column>
            <column caption='Orders Selected Year' datatype='string' name='[Calculation_984318014302420992]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1]&#13;&#10;THEN [Order ID]&#13;&#10;END' />
            </column>
            <column caption='Metric Swap Calcs PY (label)' datatype='string' name='[Metric Swap Calcs SY (label) (copy)_345651293208100869]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Sales&quot; THEN &quot;$&quot; + STR(ROUND(SUM([Sales Selected Year (copy)_1457758924820250625])/1000, 1)) + &quot;K&quot;&#13;&#10;WHEN &quot;Profit&quot; THEN &quot;$&quot; + STR(ROUND(SUM([Calculation_1457758924846129160])/1000, 1)) + &quot;K&quot;&#13;&#10;WHEN &quot;Orders&quot; THEN STR(COUNTD([Orders Selected Year (copy)_984318014302593025]))&#13;&#10;END' />
            </column>
            <column caption='Metric Swap Calcs Sign' datatype='real' default-format='*🡅;🡇' name='[Metric Swap Calcs YoY (copy)_345651293208981511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Sales&quot; THEN (SUM([Calculation_1457758924819922944]) - SUM([Sales Selected Year (copy)_1457758924820250625])) / SUM([Sales Selected Year (copy)_1457758924820250625])&#13;&#10;WHEN &quot;Profit&quot; THEN (SUM([Calculation_1457758924845793287]) - SUM([Calculation_1457758924846129160])) / SUM([Calculation_1457758924846129160])&#13;&#10;WHEN &quot;Orders&quot; THEN (COUNTD([Calculation_984318014302420992]) - COUNTD([Orders Selected Year (copy)_984318014302593025])) / COUNTD([Orders Selected Year (copy)_984318014302593025])&#13;&#10;END' />
