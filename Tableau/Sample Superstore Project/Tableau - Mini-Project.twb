          <datasource-dependencies datasource='federated.1dvdmde06x56491ec5whj0g1w0bu'>
            <column caption='Customers Selected Year' datatype='string' name='[Calculation_984318014303916036]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1]&#13;&#10;THEN [Customer ID]&#13;&#10;END' />
            </column>
            <column caption='Customers Previous Year' datatype='string' name='[Calculation_984318014304038917]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1] - 1&#13;&#10;THEN [Customer ID]&#13;&#10;END' />
